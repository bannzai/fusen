{
  "name": "fusen",
  "displayName": "Fusen",
  "description": "Sticky notes on code lines for two-way review with AI agents",
  "version": "0.0.1",
  "private": true,
  "publisher": "bannzai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bannzai/fusen"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "package": "cp ../../LICENSE ../../README.md . && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0"
  }
}
