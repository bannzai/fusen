{
  "name": "fusen-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build -w fusen-core && npm run typecheck --workspaces && tsc -p e2e --noEmit",
    "test": "npm run test --workspaces --if-present && bash .claude/skills/ci-e2e/scripts/test/test-fetch-e2e-screenshots.sh",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^7.0.2"
  }
}
